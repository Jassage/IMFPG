generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}

enum ControlType {
  CONTROLE_1
  CONTROLE_2
  CONTROLE_3
  CONTROLE_4
}

enum DocumentType {
  BULLETIN
  RELEVE
  ATTESTATION_NIVEAU
  ATTESTATION_FIN_ETUDES
  CERTIFICAT_SCOLARITE
}

enum TranscriptStatus {
  DRAFT
  GENERATED
  PUBLISHED
  ARCHIVED
  DELETED
}

enum DocumentLanguage {
  FR
  EN
}

enum DocumentAction {
  GENERATED
  DOWNLOADED
  MODIFIED
  VIEWED
  DELETED
}

enum EnrollmentStatus {
  Active
  Suspended
  Completed
}

enum GradeStatus {
  Draft
  Submitted
  Approved
  Rejected
  Published
  Archived
}

enum GradeSession {
  Normale
  Reprise
}

enum UserRole {
  Admin
  Professeur
  Secretaire
  Directeur
  Comptable
  Student
  Parent
}

enum UserStatus {
  Actif
  Inactif
}

enum ProfesseurStatus {
  Actif
  Inactif
}

enum StudentStatus {
  Active
  Inactive
  Graduated
  Suspended
}

enum StudentSexe {
  Masculin
  Feminin
  Autre
}

enum SubjectType {
  Obligatoire
  Optionnelle
}

enum ClassLevel {
  Sixieme
  Cinquieme
  Quatrieme
  Troisieme
  Seconde
  Premiere
  Terminale
  NSI
  NSII
  NSIII
  NSIV
}

// ============================================
// ATTENDANCE ENUMS
// ============================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HOLIDAY
  SICK
  SUSPENDED
  OTHER
}

enum AttendanceSessionn {
  MORNING
  AFTERNOON
  FULL_DAY
}

enum AttendanceValidationStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum AttendanceJustificationType {
  MEDICAL_CERTIFICATE
  FAMILY_REASON
  ADMINISTRATIVE
  TRANSPORT_ISSUE
  OTHER
}

// ============================================
// MODELS
// ============================================

model Subject {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  coefficient        Int                 @default(1)
  type               SubjectType
  passingGrade       Int                 @default(50)
  maxGrade           Int
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String
  assignments        ClassAssignment[]
  grades             Grade[]
  professeurs        ProfesseurSubject[]
  createdBy          User                @relation("CreatedSubject", fields: [createdById], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]

  @@index([createdById])
  @@map("subjects")
}

model ClassAssignment {
  id             String     @id @default(cuid())
  subjectId      String
  professeurId   String
  classLevel     ClassLevel
  academicYearId String
  status         String     @default("Active")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  professeur   Professeur   @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedules    Schedule[]
  grades       Grade[]

  @@unique([subjectId, classLevel, academicYearId, professeurId])
  @@index([academicYearId])
  @@index([professeurId])
  @@index([subjectId])
  @@map("class_assignments")
}

model SchoolClass {
  id        String     @id @default(cuid())
  name      String
  level     ClassLevel
  capacity  Int        @default(30)
  status    String     @default("Active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  students           Student[]
  schedules          Schedule[]
  enrollments        Enrollment[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]

  @@map("school_classes")
}

model Schedule {
  id           String    @id @default(cuid())
  assignmentId String
  classId      String
  professeurId String
  dayOfWeek    String
  startTime    String
  endTime      String
  classroom    String?
  status       String    @default("ACTIVE")
  recurrence   String?
  untilDate    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  classAssignment ClassAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  professeur      Professeur      @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId, dayOfWeek, startTime])
  @@map("schedules")
}

model Transcript {
  id               String            @id @default(cuid())
  studentId        String
  academicYearId   String
  controlType      ControlType
  classLevel       ClassLevel
  documentType     DocumentType
  gpa              Float
  totalCredits     Int
  creditsEarned    Int
  successRate      Float?
  fileName         String
  pdfData          Bytes?
  status           TranscriptStatus
  generatedBy      String?
  generatedAt      DateTime          @default(now())
  language         DocumentLanguage  @default(FR)
  metadata         Json?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documentHistory  DocumentHistory[]
  transcriptGrades TranscriptGrade[]
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, controlType, documentType])
  @@index([studentId])
  @@index([academicYearId])
  @@index([controlType])
  @@index([documentType])
  @@index([generatedAt])
  @@index([status])
  @@map("transcripts")
}

model TranscriptGrade {
  id           String     @id @default(cuid())
  transcriptId String
  gradeId      String
  order        Int
  createdAt    DateTime   @default(now())
  grade        Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, gradeId])
  @@index([transcriptId])
  @@index([gradeId])
  @@index([order])
  @@map("transcript_grades")
}

model AcademicYear {
  id                 String              @id @default(cuid())
  year               String              @unique
  startDate          DateTime
  endDate            DateTime
  isCurrent          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        ClassAssignment[]
  enrollments        Enrollment[]
  grades             Grade[]
  studentFees        StudentFee[]
  transcripts        Transcript[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  attendanceStats    AttendanceStats[]
  attendanceHolidays AttendanceHoliday[]

  @@map("academic_years")
}

model FeeStructure {
  id           String       @id @default(cuid())
  name         String
  academicYear String
  amount       Float
  description  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  studentFees  StudentFee[]

  @@map("fee_structures")
}

model StudentFee {
  id             String       @id @default(cuid())
  studentId      String
  feeStructureId String
  totalAmount    Float
  paidAmount     Float        @default(0)
  status         String       @default("pending")
  dueDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYearId String
  payments       FeePayment[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeStructureId, academicYearId])
  @@index([academicYearId])
  @@index([feeStructureId])
  @@index([studentId])
  @@map("student_fees")
}

model FeePayment {
  id            String     @id @default(cuid())
  studentFeeId  String
  amount        Float
  paymentDate   DateTime   @default(now())
  paymentMethod String
  description   String?
  reference     String?
  recordedBy    String
  createdAt     DateTime   @default(now())
  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
  @@map("fee_payments")
}

model DocumentHistory {
  id           String         @id @default(cuid())
  transcriptId String
  action       DocumentAction
  performedBy  String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  performedAt  DateTime       @default(now())
  transcript   Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([action])
  @@index([performedAt])
  @@map("document_history")
}

model Analytics {
  id            String   @id @default(cuid())
  type          String
  data          Json
  generatedDate DateTime @default(now())
  parameters    Json

  @@map("analytics")
}

model Announcement {
  id             String    @id @default(cuid())
  title          String
  content        String
  authorId       String
  publishDate    DateTime
  expiryDate     DateTime?
  targetAudience String
  priority       String
  isActive       Boolean   @default(true)
  attachments    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([publishDate])
  @@index([isActive])
  @@map("announcements")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  organizer   String?
  category    String
  isPublic    Boolean  @default(true)
  status      String   @default("Scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([category])
  @@index([isPublic])
  @@map("events")
}

model Grade {
  id             String      @id @default(cuid())
  studentId      String
  subjectId      String
  assignmentId   String
  grade          Float
  status         GradeStatus
  controlType    ControlType
  createdAt      DateTime    @default(now())
  academicYearId String
  classLevel     ClassLevel
  isActive       Boolean     @default(true)
  updatedAt      DateTime    @updatedAt
  notes          String?

  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classAssignment  ClassAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  transcriptGrades TranscriptGrade[]
  createdBy        String?
  submittedAt      DateTime?
  submittedBy      String?
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?
  publishedAt      DateTime?
  publishedBy      String?

  createdByUser   User? @relation("CreatedGrades", fields: [createdBy], references: [id])
  submittedByUser User? @relation("SubmittedGrades", fields: [submittedBy], references: [id])
  approvedByUser  User? @relation("ApprovedGrades", fields: [approvedBy], references: [id])
  rejectedByUser  User? @relation("RejectedGrades", fields: [rejectedBy], references: [id])
  publishedByUser User? @relation("PublishedGrades", fields: [publishedBy], references: [id])

  @@unique([studentId, subjectId, academicYearId, controlType, assignmentId])
  @@index([academicYearId, controlType])
  @@index([studentId, academicYearId])
  @@index([studentId, subjectId])
  @@index([assignmentId])
  @@index([subjectId])
  @@map("grades")
}

model Professeur {
  id         String           @id @default(cuid())
  firstName  String
  lastName   String
  email      String           @unique
  phone      String?
  speciality String?
  matricule  String           @unique
  status     ProfesseurStatus @default(Actif)

  address        String?
  qualifications String?
  hireDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String?   @unique

  assignments        ClassAssignment[]
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules          Schedule[]
  subjectsTaught     ProfesseurSubject[]
  attendanceSessions AttendanceSession[]

  @@map("professeurs")
}

model ProfesseurSubject {
  id                String   @id @default(cuid())
  professeurId      String
  subjectId         String
  isPrimary         Boolean  @default(false)
  yearsOfExperience Int?     @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  professeur Professeur @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([professeurId, subjectId])
  @@index([professeurId])
  @@index([subjectId])
  @@index([isPrimary])
  @@map("professeur_subjects")
}

model User {
  id               String     @id @default(cuid())
  firstName        String
  lastName         String
  email            String     @unique
  phone            String?
  role             UserRole
  failedAttempts   Int        @default(0)
  lockUntil        DateTime?
  status           UserStatus
  lastLogin        DateTime?
  avatar           String?
  password         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?

  isInitialPassword Boolean   @default(true)
  passwordChangedAt DateTime?

  auditLogs       AuditLog[]
  loginAttempts   LoginAttempt[]
  professeur      Professeur?
  studentRecord   Student?
  parent          Parent?
  createdSubjects Subject[]      @relation("CreatedSubject")
  announcements   Announcement[]
  createdGrades   Grade[]        @relation("CreatedGrades")
  submittedGrades Grade[]        @relation("SubmittedGrades")
  approvedGrades  Grade[]        @relation("ApprovedGrades")
  rejectedGrades  Grade[]        @relation("RejectedGrades")
  publishedGrades Grade[]        @relation("PublishedGrades")

  // Attendance relations
  attendanceCreated         Attendance[]        @relation("AttendanceCreated")
  attendanceValidated       Attendance[]        @relation("AttendanceValidated")
  attendanceJustified       Attendance[]        @relation("AttendanceJustified")
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreated")
  attendanceRecordsRecorded AttendanceRecord[]  @relation("AttendanceRecordRecorded")

  @@index([email, status])
  @@index([role, status])
  @@map("users")
}

model Student {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  studentCode  String        @unique
  email        String        @unique
  phone        String?
  dateOfBirth  DateTime?
  placeOfBirth String?
  address      String?
  photo        String?
  bloodGroup   BloodGroup?
  allergies    String?
  disabilities String?
  status       StudentStatus @default(Active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String?       @unique
  cin          String?       @unique
  sexe         StudentSexe?
  classId      String?

  enrollments Enrollment[]
  grades      Grade[]
  guardians   Guardian[]
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentFees StudentFee[]
  transcripts Transcript[]
  schoolClass SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  // Attendance relations
  attendances       Attendance[]
  attendanceStats   AttendanceStats[]
  attendanceRecords AttendanceRecord[]

  @@index([studentCode])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([classId])
  @@map("students")
}

model Guardian {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@index([phone])
  @@index([isPrimary])
  @@map("guardians")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians Guardian[]

  @@map("parents")
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(Active)

  isReenrollment       Boolean   @default(false)
  previousEnrollmentId String?
  reenrollmentDate     DateTime?
  reenrollmentNotes    String?

  previousEnrollment Enrollment?  @relation("EnrollmentChain", fields: [previousEnrollmentId], references: [id])
  nextEnrollments    Enrollment[] @relation("EnrollmentChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([classId])
  @@index([studentId])
  @@index([previousEnrollmentId])
  @@map("enrollments")
}

model LoginAttempt {
  id             String   @id @default(cuid())
  userId         String
  failedAttempts Int      @default(0)
  attemptTime    DateTime @default(now())
  ipAddress      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("login_attempts")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entity       String
  entityId     String?
  description  String
  oldData      Json?
  newData      Json?
  userId       String?
  userAgent    String?
  ipAddress    String?
  status       String?
  errorMessage String?
  metadata     Json?
  duration     Int?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([entityId])
  @@index([entity])
  @@index([status])
  @@index([userId])
  @@map("audit_logs")
}

model SystemSettings {
  id            String @id @default(cuid())
  schoolName    String @default("Institution Mixte Faustin 1er")
  schoolSlogan  String @default("L'excellence pour tous")
  schoolLogo    String @default("/logo.png")
  schoolFavicon String @default("/favicon.ico")

  phone          String  @default("+509 00 00 0000")
  secondaryPhone String?
  email          String  @default("contact@imfp.ht")
  secondaryEmail String?
  website        String? @default("https://www.imfp.ht")
  address        String? @default("123 Rue de l'École")
  city           String? @default("Port-au-Prince")
  country        String? @default("Haïti")
  postalCode     String?

  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  youtube   String?

  currentAcademicYearId String?
  gradingSystem         String  @default("percentage")
  passingGrade          Int     @default(50)
  maxGrade              Int     @default(100)

  currency       String @default("HTG")
  currencySymbol String @default("HTG")
  taxRate        Float  @default(0)
  latePaymentFee Float  @default(500)
  paymentMethods Json   @default("[\"Espèces\", \"MonCash\", \"NatCash\", \"Virement bancaire\", \"Chèque\"]")

  enableEmailNotifications Boolean @default(true)
  enableSmsNotifications   Boolean @default(true)
  enablePushNotifications  Boolean @default(false)

  sessionTimeout   Int     @default(30)
  maxLoginAttempts Int     @default(5)
  twoFactorAuth    Boolean @default(false)
  passwordPolicy   Json    @default("{\"minLength\":8,\"requireUppercase\":true,\"requireLowercase\":true,\"requireNumbers\":true,\"requireSpecialChars\":false}")

  primaryColor   String @default("#2563eb")
  secondaryColor String @default("#4f46e5")
  accentColor    String @default("#f59e0b")
  fontFamily     String @default("Inter")

  enabledModules Json @default("{\"attendance\":true,\"library\":false,\"transport\":false,\"hostel\":false,\"payroll\":true,\"inventory\":false}")

  autoBackup      Boolean   @default(true)
  backupFrequency String    @default("daily")
  backupRetention Int       @default(30)
  lastBackup      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}

// ============================================
// ATTENDANCE MODELS
// ============================================

model Attendance {
  id             String             @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  date           DateTime           @map("attendance_date")
  session        AttendanceSessionn @default(FULL_DAY)
  status         AttendanceStatus   @default(PRESENT)

  checkInTime      DateTime?
  checkOutTime     DateTime?
  expectedCheckIn  String?
  expectedCheckOut String?

  validationStatus AttendanceValidationStatus @default(PENDING)
  validatedBy      String?
  validatedAt      DateTime?

  justification     String?
  justificationType AttendanceJustificationType?
  justificationDoc  String?
  justifiedAt       DateTime?
  justifiedBy       String?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass       SchoolClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("AttendanceCreated", fields: [createdById], references: [id])
  validatedByUser   User?              @relation("AttendanceValidated", fields: [validatedBy], references: [id])
  justifiedByUser   User?              @relation("AttendanceJustified", fields: [justifiedBy], references: [id])
  attendanceRecords AttendanceRecord[]

  @@unique([studentId, classId, academicYearId, date, session])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([academicYearId])
  @@index([status])
  @@index([validationStatus])
  @@map("attendances")
}

model AttendanceSession {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  professeurId   String
  academicYearId String
  date           DateTime
  startTime      String
  endTime        String
  topic          String?
  description    String?

  isCompleted        Boolean @default(false)
  isCancelled        Boolean @default(false)
  cancellationReason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolClass  SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professeur   Professeur   @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AttendanceSessionCreated", fields: [createdById], references: [id])

  attendanceRecords AttendanceRecord[]

  @@unique([classId, subjectId, professeurId, date, startTime])
  @@index([classId])
  @@index([subjectId])
  @@index([professeurId])
  @@index([date])
  @@index([academicYearId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus @default(PRESENT)
  notes               String?
  checkInTime         DateTime?
  recordedById        String?
  attendanceId        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy        User?             @relation("AttendanceRecordRecorded", fields: [recordedById], references: [id])
  attendance        Attendance?       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
  @@index([attendanceId])
  @@map("attendance_records")
}

model AttendanceStats {
  id             String @id @default(cuid())
  studentId      String
  academicYearId String
  month          Int
  year           Int

  totalDays   Int @default(0)
  presentDays Int @default(0)
  absentDays  Int @default(0)
  lateDays    Int @default(0)
  excusedDays Int @default(0)
  sickDays    Int @default(0)

  attendanceRate  Float @default(0)
  punctualityRate Float @default(0)

  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, month, year])
  @@index([studentId])
  @@index([academicYearId])
  @@index([month, year])
  @@map("attendance_stats")
}

model AttendanceSettings {
  id       String @id @default(cuid())
  schoolId String @default("default")

  defaultMorningStart   String @default("08:00")
  defaultMorningEnd     String @default("12:00")
  defaultAfternoonStart String @default("14:00")
  defaultAfternoonEnd   String @default("17:00")

  lateThreshold     Int  @default(15)
  autoValidateAfter Int?

  notifyOnAbsence        Boolean @default(true)
  notifyParentsOnAbsence Boolean @default(true)
  notifyOnLate           Boolean @default(true)

  requireJustification   Boolean @default(true)
  maxConsecutiveAbsences Int     @default(5)
  alertThreshold         Int     @default(80)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId])
  @@map("attendance_settings")
}

model AttendanceHoliday {
  id             String   @id @default(cuid())
  name           String
  date           DateTime
  type           String
  recurring      Boolean  @default(false)
  academicYearId String?

  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@unique([date, academicYearId])
  @@index([date])
  @@index([type])
  @@index([academicYearId])
  @@map("attendance_holidays")
}
